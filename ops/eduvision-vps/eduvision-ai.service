[Unit]
Description=EduVision AI Node service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eduvision
Group=eduvision
WorkingDirectory=/opt/eduvision-ai
Environment=NODE_ENV=production
Environment=PORT=8791
Environment=CONFIG_FILE=/var/lib/eduvision-ai/config.env
Environment=USER_DATA_DIR=/var/lib/eduvision-ai/data
Environment=SESSION_DATA_DIR=/opt/eduvision-ai/.session-data
EnvironmentFile=/var/lib/eduvision-ai/config.env
ExecStart=/usr/bin/npm run dev:node --workspace worker
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/eduvision-ai /var/lib/eduvision-ai

[Install]
WantedBy=multi-user.target
