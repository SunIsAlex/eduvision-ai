{
  "name": "eduvision-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Homework Solver — multimodal Claude powered Node.js backend + React frontend",
  "workspaces": [
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n worker,frontend -c blue,green \"npm:dev:worker:node\" \"npm:dev:frontend\"",
    "dev:worker:node": "npm run dev:node --workspace worker",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run typecheck && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace worker && npm run typecheck --workspace frontend",
    "test:tools": "tsx worker/scripts/tools-e2e.ts",
    "test:accounts": "tsx worker/scripts/accounts-e2e.ts",
    "test:skills": "node worker/scripts/sync-gaokao-corpus.mjs --check",
    "sync:gaokao": "node worker/scripts/sync-gaokao-corpus.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
