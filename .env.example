# Copy to .env and fill in for local development.
# Note: Cloudflare Workers use `wrangler secret put SILICONFLOW_API_KEY` in
# production — NEVER commit real keys or put them in wrangler.toml.

# Required: SiliconFlow API key (https://cloud.siliconflow.cn)
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional overrides (safe defaults are already compiled in)
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CORS_ORIGIN=*

# Optional: single multimodal answering model override.
# Default: Qwen/Qwen3-VL-8B-Thinking
# Stronger Chinese OCR option: Qwen/Qwen2.5-VL-72B-Instruct
AI_MODEL=

# Local vector-store bindings (populated by `wrangler dev`).
# Create namespaces/buckets locally first:
#   wrangler kv namespace create KNOWLEDGE_STORE
#   wrangler r2 bucket create eduvision-media
KNOWLEDGE_STORE_ID=
MEDIA_BUCKET_NAME=eduvision-media
