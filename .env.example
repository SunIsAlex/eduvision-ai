API_URL=https://api.mytokk.com
API_KEY=sk-xxxxxxxxxxxxxxxx
API_MODEL=claude-sonnet-4-6

# 多用户注册。生产环境建议设置邀请码；创建完所需账号后可改为 false。
ALLOW_REGISTRATION=true
REGISTRATION_CODE=replace-with-a-private-invitation-code

# 可选：显式指定登录 Cookie 签名密钥；未设置时服务器会在用户数据目录自动生成并持久化。
# AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# 管理面板 /admin 的独立密码。
ADMIN_ACCESS_PASSWORD=replace-with-a-strong-admin-password
